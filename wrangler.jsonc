// Deploy na Cloudflare (plano gratuito): Worker que serve o site estático de web/.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nie-infra",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-14",
  "observability": { "enabled": true },
  "assets": { "directory": "./web", "binding": "ASSETS" },
  // A versão anterior (Streamlit em container) criou a classe AppStreamlit.
  // A migração v2 a remove; as duas precisam ficar registradas aqui.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AppStreamlit"] },
    { "tag": "v2", "deleted_classes": ["AppStreamlit"] }
  ]
}
